# Токен от @BotFather
BOT_TOKEN=replace_locally

# Числовой Telegram id админа (заявки и /post)
ADMIN_ID=your_numeric_telegram_id

# Куда публиковать /post и отложенные посты: @channel или -100…
CHANNEL_ID=@molitva_deploy

# Если задано — отложенные посты идут сюда вместо CHANNEL_ID (проверка без канала)
# Обычно тот же ADMIN_ID
# DRY_CHANNEL=123456789
